{
  "schemaVersion": 1,
  "id": "madoku-craft-attributes",
  "version": "${version}",
  "name": "Madoku Craft: Attributes",
  "description": "A configurable attribute overhaul mod.",
  "authors": ["Monkeyopolis"],
  "license": "CC0-1.0",
  "environment": "*",
  "entrypoints": {
    "main": ["madoku.craft.java.attributes.MadokuAttributesInitializer"],
    "client": ["madoku.craft.java.attributes.MadokuAttributesClientInitializer"]
  },
  "mixins": ["madoku-craft-attributes.mixins.json"],
  "depends": {
    "fabricloader": "${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "${fabric_api_version}",
    "madoku-craft-core": "*"
  }
}
