{
	"schemaVersion": 1,
	"id": "madoku-craft-attributes",
	"version": "${version}",
	"name": "Madoku Craft Attributes",
	"description": "A configurable Attribute overhaul system.",
	"authors": [
		"Monkeyopolis"
	],
	"contact": {
		"sources": "https://github.com/Monkeyopolis/Madoku-Craft-Attributes"
	},
	"license": "CC0-1.0",
	"icon": "assets/madoku-craft-attributes/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"madoku.craft.attributes.MadokuCraftAttributes"
		],
		"client": [
			"madoku.craft.attributes.MadokuCraftAttributesClient"
		]
	},
	"mixins": [
		"madoku-craft-attributes.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.5",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": "*",
		"madoku-craft-api": "${madoku_craft_api_mod_version}"
